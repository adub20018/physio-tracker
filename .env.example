# Template for environment variables.
#
# DATABASE_URL, DATABASE_URL_UNPOOLED, NEON_AUTH_BASE_URL, and
# NEON_AUTH_COOKIE_SECRET are generated by Neon (Postgres + Neon Auth) and
# normally land in .env.local automatically via `vercel env pull` or the
# Vercel/Neon dashboard integration — you shouldn't need to hand-copy them
# from here. This file just documents what's required and why.

# Neon Postgres connection strings. Pooled (via pgbouncer) for normal app
# queries; unpooled for drizzle-kit migrations, which need a direct connection.
DATABASE_URL="postgresql://..."
DATABASE_URL_UNPOOLED="postgresql://..."

# Neon Auth (hosted auth, backed by the same Neon project). Auto-defined by
# Neon once Auth is enabled on the project — see src/auth/server.ts.
NEON_AUTH_BASE_URL="https://....neonauth...aws.neon.tech/.../auth"
NEON_AUTH_COOKIE_SECRET=""

# PrimeUI Community license key (free for individuals) from your PrimeUI
# account. NEXT_PUBLIC_ because it configures the client-side UI library.
# Without it the app still works but logs a license warning in the console.
NEXT_PUBLIC_PRIMEUI_LICENSE_KEY=""
