# Template for environment variables — copy to .env.local and fill in.
# Local development works with no env file at all (defaults to file:./dev.db).

# Database. Local dev: file:./dev.db | Production: Turso libsql:// URL
DATABASE_URL="file:./dev.db"
# Auth token for remote Turso databases only; leave unset for local files.
DATABASE_AUTH_TOKEN=""

# PrimeUI Community license key (free for individuals) from your PrimeUI
# account. NEXT_PUBLIC_ because it configures the client-side UI library.
# Without it the app still works but logs a license warning in the console.
NEXT_PUBLIC_PRIMEUI_LICENSE_KEY=""
